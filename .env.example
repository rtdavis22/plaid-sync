# Copy to .env and fill in. Use the PRODUCTION secret, not the Sandbox one.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Personal access token from the Airtable account that owns the base
# (airtable.com/create/tokens). Scopes needed:
#   data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_TOKEN=
# Run "npm run setup-airtable" with no base id to list the ones the token can see.
AIRTABLE_BASE_ID=

# Only needed for "npm run receipts", which reads grocery receipts into line items.
ANTHROPIC_API_KEY=
